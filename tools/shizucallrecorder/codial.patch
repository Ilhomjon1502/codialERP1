+private fun typeIcon(type: Int): Pair<ImageVector, Color> = when (type) {
+    CallLog.Calls.OUTGOING_TYPE -> Icons.AutoMirrored.Filled.CallMade to Palette.green
+    CallLog.Calls.MISSED_TYPE -> Icons.AutoMirrored.Filled.CallMissed to Palette.red
+    CallLog.Calls.REJECTED_TYPE, CallLog.Calls.BLOCKED_TYPE -> Icons.Filled.Block to Palette.red
+    else -> Icons.AutoMirrored.Filled.CallReceived to Palette.blue
