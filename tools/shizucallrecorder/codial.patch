+                        NavigationBar {
+                            NavigationBarItem(selected = tab == 0, onClick = { tab = 0 }, icon = { Icon(Icons.Filled.History, null) }, label = { Text("So'nggilar") })
+                            NavigationBarItem(selected = tab == 1, onClick = { tab = 1 }, icon = { Icon(Icons.Filled.People, null) }, label = { Text("Kontaktlar") })
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
