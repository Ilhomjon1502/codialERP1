@@ -0,0 +1,197 @@
+package uz.codial.calls.phone
+
+import android.Manifest
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Bundle
+import android.provider.CallLog
+import android.provider.ContactsContract
+import android.telecom.TelecomManager
+import android.widget.Toast
+import androidx.compose.runtime.mutableStateMapOf
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import uz.codial.calls.Api
+import uz.codial.calls.PhoneAccess
+import java.net.URLEncoder
+
+/** Qo'ng'iroqlar jurnali, kontaktlar va ERP ma'lumoti (ismlar, qidiruv, karta) — terish ilovasi ekranlari uchun. */
+
+data class CallEntry(val number: String, val cachedName: String, val type: Int, val date: Long, val duration: Long)
+
+data class ContactEntry(val name: String, val number: String)
+
+/** ERP'dagi odam: ism va kimligi (o'quvchi, ota-ona, lid). */
+data class ErpName(val title: String, val badge: String)
+
+/** Qidiruv va takliflar qatori. */
+data class Hit(val title: String, val subtitle: String, val number: String)
+
+/** Raqamning solishtirish kaliti: oxirgi 9 raqam (+998 bilan ham, usiz ham bir xil). */
+fun numberKey(number: String): String = number.filter { it.isDigit() }.let { if (it.length > 9) it.takeLast(9) else it }
+
+/** +998 90 123 45 67 ko'rinishi; boshqa raqamlar o'zgarmaydi. */
+fun prettyNumber(number: String): String {
+    val d = number.filter { it.isDigit() }
+    val n = when {
+        d.length == 12 && d.startsWith("998") -> d.substring(3)
+        d.length == 9 && !number.startsWith("+") -> d
+        else -> return number.ifEmpty { "Yashirin raqam" }
+    }
+    return "+998 ${n.substring(0, 2)} ${n.substring(2, 5)} ${n.substring(5, 7)} ${n.substring(7)}"
+}
+
+fun Context.has(permission: String) = checkSelfPermission(permission) == PackageManager.PERMISSION_GRANTED
+
+object PhoneData {
+    private const val MAX_CALLS = 600
+
+    suspend fun calls(ctx: Context): List<CallEntry> = withContext(Dispatchers.IO) {
+        val out = ArrayList<CallEntry>()
+        if (!ctx.has(Manifest.permission.READ_CALL_LOG)) return@withContext out
+        val cols = arrayOf(CallLog.Calls.NUMBER, CallLog.Calls.CACHED_NAME, CallLog.Calls.TYPE, CallLog.Calls.DATE, CallLog.Calls.DURATION)
+        runCatching {
+            ctx.contentResolver.query(CallLog.Calls.CONTENT_URI, cols, null, null, CallLog.Calls.DATE + " DESC")?.use { c ->
+                while (out.size < MAX_CALLS && c.moveToNext()) {
+                    out.add(CallEntry(c.getString(0).orEmpty(), c.getString(1).orEmpty(), c.getInt(2), c.getLong(3), c.getLong(4)))
+                }
+            }
+        }
+        out
+    }
+
+    suspend fun contacts(ctx: Context): List<ContactEntry> = withContext(Dispatchers.IO) {
+        val out = LinkedHashMap<String, ContactEntry>()
+        if (!ctx.has(Manifest.permission.READ_CONTACTS)) return@withContext emptyList<ContactEntry>()
+        val phone = ContactsContract.CommonDataKinds.Phone.NUMBER
+        val name = ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME
+        runCatching {
+            ctx.contentResolver.query(ContactsContract.CommonDataKinds.Phone.CONTENT_URI, arrayOf(name, phone), null, null, "$name COLLATE NOCASE ASC")?.use { c ->
+                while (c.moveToNext()) {
+                    val n = c.getString(1)?.replace(" ", "")?.replace("-", "").orEmpty()
+                    if (n.isNotEmpty()) out.putIfAbsent(numberKey(n), ContactEntry(c.getString(0).orEmpty(), n))
+                }
+            }
+        }
+        out.values.toList()
+    }
+
+    /** Oxirgi terilgan (chiquvchi) raqam — bo'sh maydonda yashil tugma uchun. */
+    fun lastDialed(calls: List<CallEntry>): String = calls.firstOrNull { it.type == CallLog.Calls.OUTGOING_TYPE && it.number.isNotEmpty() }?.number.orEmpty()
+
+    fun dial(ctx: Context, number: String) {
+        if (number.isBlank()) return
+        if (!ctx.has(Manifest.permission.CALL_PHONE)) {
+            toast(ctx, "Qo'ng'iroqqa ruxsat berilmagan")
+            return
+        }
+        try {
+            ctx.getSystemService(TelecomManager::class.java).placeCall(Uri.fromParts("tel", number, null), Bundle())
+        } catch (e: SecurityException) {
+            toast(ctx, "Qo'ng'iroqqa ruxsat yo'q")
+        }
+    }
+
+    /** Telefonning SMS ilovasini shu raqam bilan ochadi (SMS shu ilovaning ichida yuborilmaydi). */
+    fun sms(ctx: Context, number: String) {
+        if (number.isBlank()) return
+        try {
+            ctx.startActivity(Intent(Intent.ACTION_SENDTO, Uri.fromParts("smsto", number, null)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+        } catch (e: RuntimeException) {
+            toast(ctx, "SMS ilovasi topilmadi")
+        }
+    }
+
+    fun copy(ctx: Context, number: String) {
+        ctx.getSystemService(ClipboardManager::class.java).setPrimaryClip(ClipData.newPlainText("raqam", number))
+        toast(ctx, "Raqam nusxalandi")
+    }
+
+    private fun toast(ctx: Context, text: String) = Toast.makeText(ctx, text, Toast.LENGTH_LONG).show()
+}
+
+object Erp {
+    private const val REFRESH_MS = 10 * 60_000L
+    private const val BATCH = 300
+
+    /** Raqam kaliti → ERP ismi. Saqlanadi: internet bo'lmaganda ham ismlar ko'rinadi. */
+    val names = mutableStateMapOf<String, ErpName>()
+    private val asked = HashSet<String>()
+    private var askedAt = 0L
+    private var restored = false
+
+    private fun prefs(ctx: Context) = ctx.getSharedPreferences("erp_names", Context.MODE_PRIVATE)
+
+    private fun restore(ctx: Context) {
+        if (restored) return
+        restored = true
+        runCatching {
+            val j = JSONObject(prefs(ctx).getString("names", "{}")!!)
+            for (k in j.keys()) j.getJSONArray(k).let { names[k] = ErpName(it.getString(0), it.getString(1)) }
+        }
+    }
+
+    private fun save(ctx: Context) {
+        val j = JSONObject()
+        for ((k, v) in names) j.put(k, JSONArray().put(v.title).put(v.badge))
+        prefs(ctx).edit().putString("names", j.toString()).apply()
+    }
+
+    /** Ro'yxatdagi raqamlar ismini serverdan oladi (yangilari darhol, hammasi 10 daqiqada bir qayta). Asosiy oqimdan chaqiriladi. */
+    suspend fun resolve(ctx: Context, numbers: List<String>) {
+        restore(ctx)
+        val now = System.currentTimeMillis()
+        if (now - askedAt > REFRESH_MS) {
+            asked.clear()
+            askedAt = now
+        }
+        val need = numbers.map { numberKey(it) }.filter { it.length == 9 && it !in asked }.distinct().take(BATCH)
+        if (need.isEmpty()) return
+        asked.addAll(need)
+        val found = withContext(Dispatchers.IO) {
+            runCatching {
+                val p = PhoneAccess.of(ctx)
+                if (p.token.isEmpty()) return@runCatching null
+                Api.request(p.server, "names/", p.token, JSONObject().put("numbers", JSONArray(need))).getJSONObject("names")
+            }.getOrNull()
+        }
+        if (found == null) {
+            asked.removeAll(need.toSet())  // internet yo'q — keyingi safar qayta
+            return
+        }
+        for (k in need) {
+            val v = found.optJSONObject(k)
+            if (v == null) names.remove(k) else names[k] = ErpName(v.optString("title"), v.optString("badge"))
+        }
+        save(ctx)
+    }
+
+    /** ERP bo'yicha qidiruv (kamida 3 belgi). null — serverga ulanib bo'lmadi. */
+    suspend fun search(ctx: Context, query: String): List<Hit>? = withContext(Dispatchers.IO) {
+        if (query.trim().length < 3) return@withContext emptyList<Hit>()
+        runCatching {
+            val p = PhoneAccess.of(ctx)
+            if (p.token.isEmpty()) return@runCatching emptyList<Hit>()
+            val rows = Api.request(p.server, "search/?q=" + URLEncoder.encode(query.trim(), "UTF-8"), p.token, null).getJSONArray("results")
+            List(rows.length()) { i ->
+                val r = rows.getJSONObject(i)
+                Hit(r.optString("title"), r.optString("badge"), "+998" + r.optString("phone"))
+            }
+        }.getOrNull()
+    }
+
+    /** Raqam sahifasidagi karta: {badge, title, lines}. null — olinmadi. */
+    suspend fun card(ctx: Context, number: String): JSONObject? = withContext(Dispatchers.IO) {
+        runCatching {
+            val p = PhoneAccess.of(ctx)
+            if (p.token.isEmpty() || number.isEmpty()) null
+            else Api.request(p.server, "lookup/?phone=" + URLEncoder.encode(number, "UTF-8"), p.token, null)
+        }.getOrNull()
+    }
+}
