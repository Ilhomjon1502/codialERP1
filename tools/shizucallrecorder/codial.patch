new file mode 100644
index 0000000..cba1ce4
--- /dev/null
+++ b/app/src/main/java/uz/codial/calls/CallReceiver.java
@@ -0,0 +1,90 @@
+package uz.codial.calls;
+
+import android.app.KeyguardManager;
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.telephony.TelephonyManager;
+
+/** Qo'ng'iroq tugaganda (IDLE) — jurnal yozilishini biroz kutib yuboradi; xizmat to'xtab qolgan bo'lsa qayta yoqadi. */
+public class CallReceiver extends BroadcastReceiver {
+    @Override
+    public void onReceive(Context ctx, Intent intent) {
+        String state = intent.getStringExtra(TelephonyManager.EXTRA_STATE);
+        if (TelephonyManager.EXTRA_STATE_OFFHOOK.equals(state) || TelephonyManager.EXTRA_STATE_RINGING.equals(state)) {
+            wakeScreen(ctx);
+            unlock(ctx);
+            return;
+        }
+        if (!TelephonyManager.EXTRA_STATE_IDLE.equals(state)) return;
+        Context app = ctx.getApplicationContext();
+        PendingResult pending = goAsync();
+        Handler h = new Handler(Looper.getMainLooper());
+        h.postDelayed(() -> {
+            CallService.start(app);
+            CallSync.request(app);
+            pending.finish();
+        }, 3000);
+        // yozuvchi ilova faylni suhbat tugagach biroz kechikib yopadi: yozuvlar papkasi 30 s va 2 daqiqadan keyin tekshiriladi
+        // (kafolat — CallService'ning har 10 daqiqalik tekshiruvi)
+        if (Recordings.enabled(app)) {
+            h.postDelayed(() -> Recordings.request(app), 30_000);
+            h.postDelayed(() -> Recordings.request(app), 120_000);
+        }
+    }
+
+    /**
+     * Android 11: yozuv uchun shell ilovasi «ko'rinadigan oyna»ga ega bo'lishi kerak (ekran o'chiq bo'lsa yozuv boshlanmaydi).
+     * Qo'ng'iroq javob berilganda ekran o'chiq bo'lsa, uni qisqa muddatga yoqamiz (ekran qulfi yo'q).
+     */
+    private static void wakeScreen(Context ctx) {
+        try {
+            PowerManager pm = (PowerManager) ctx.getSystemService(Context.POWER_SERVICE);
+            if (pm == null || pm.isInteractive()) return;
+            @SuppressWarnings("deprecation")
+            PowerManager.WakeLock wl = pm.newWakeLock(PowerManager.SCREEN_BRIGHT_WAKE_LOCK | PowerManager.ACQUIRE_CAUSES_WAKEUP | PowerManager.ON_AFTER_RELEASE, "codial:callwake");
+            wl.acquire(15_000);
+        } catch (RuntimeException ignored) {
+            // ekranni yoqib bo'lmasa — yozuv baribir urinib ko'riladi
+        }
+    }
+
+    /**
+     * Ekran qulfi (swipe) yopib turgan bo'lsa — shaffof UnlockActivity bilan yechamiz. Fondan oyna ochish cheklangani uchun
+     * ikkinchi yo'l: to'liq ekranli bildirishnoma (qo'ng'iroq turi) — Android uni qulf ustidan ochadi.
+     */
+    private static void unlock(Context ctx) {
+        try {
+            KeyguardManager km = (KeyguardManager) ctx.getSystemService(Context.KEYGUARD_SERVICE);
+            if (km == null || !km.isKeyguardLocked()) return;
+            Intent i = new Intent(ctx, UnlockActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_NO_ANIMATION | Intent.FLAG_ACTIVITY_EXCLUDE_FROM_RECENTS);
+            try {
+                ctx.startActivity(i);
+            } catch (RuntimeException ignored) {
+                // fondan ochish taqiqlangan bo'lishi mumkin — pastdagi bildirishnoma yo'li
+            }
+            NotificationManager nm = (NotificationManager) ctx.getSystemService(Context.NOTIFICATION_SERVICE);
+            NotificationChannel ch = new NotificationChannel("unlock", "Qo'ng'iroq yozuvi", NotificationManager.IMPORTANCE_HIGH);
+            nm.createNotificationChannel(ch);
+            PendingIntent pi = PendingIntent.getActivity(ctx, 77, i, PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+            Notification n = new Notification.Builder(ctx, "unlock")
+                    .setSmallIcon(android.R.drawable.sym_call_incoming)
+                    .setContentTitle("Qo'ng'iroq yozilmoqda")
+                    .setCategory(Notification.CATEGORY_CALL)
+                    .setFullScreenIntent(pi, true)
+                    .setTimeoutAfter(8_000)
+                    .setAutoCancel(true)
+                    .build();
+            nm.notify(7701, n);
+        } catch (RuntimeException ignored) {
+            // qulfni yechib bo'lmasa — yozuv baribir urinib ko'riladi
+        }
+    }
+}
