+package uz.codial.calls.phone;
+
+import android.content.Context;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.telecom.Call;
+
+import org.json.JSONObject;
+
+import java.net.URLEncoder;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+import uz.codial.calls.Api;
+import uz.codial.calls.PhoneAccess;
+
+/** Faol qo'ng'iroqlar va qo'ng'iroqchi kartalari (xizmat, ekran va bildirishnoma uchun umumiy holat). */
+final class Phone {
+    static volatile CodialInCallService service;
+    static final List<Call> calls = new CopyOnWriteArrayList<>();
+    private static final List<Runnable> listeners = new CopyOnWriteArrayList<>();
+    private static final Map<String, JSONObject> cards = new ConcurrentHashMap<>();
+    private static final ExecutorService NET = Executors.newSingleThreadExecutor();
+    private static final Handler UI = new Handler(Looper.getMainLooper());
+
+    private Phone() {}
+
+    static void listen(Runnable r) { listeners.add(r); }
+
+    static void unlisten(Runnable r) { listeners.remove(r); }
+
+    static void changed() {
+        UI.post(() -> {
+            for (Runnable r : listeners) r.run();
+        });
+    }
+
+    static String number(Call c) {
+        Uri h = c == null || c.getDetails() == null ? null : c.getDetails().getHandle();
+        String s = h == null ? null : h.getSchemeSpecificPart();
+        return s == null ? "" : s;
+    }
+
+    /** Ekranda ko'rsatiladigan qo'ng'iroq: jiringlayotgani, keyin terilayotgani, keyin faol, keyin ushlab turilgani. */
+    static Call primary() {
+        int[] order = {Call.STATE_RINGING, Call.STATE_SELECT_PHONE_ACCOUNT, Call.STATE_DIALING, Call.STATE_CONNECTING, Call.STATE_ACTIVE, Call.STATE_HOLDING};
+        for (int st : order)
+            for (Call c : calls)
+                if (c.getState() == st) return c;
+        return calls.isEmpty() ? null : calls.get(0);
+    }
+
+    static Call other(Call first) {
+        for (Call c : calls)
+            if (c != first && c.getState() != Call.STATE_DISCONNECTED) return c;
+        return null;
+    }
+
+    static JSONObject card(String number) { return cards.get(number); }
+
+    static void forget(String number) { cards.remove(number); }
+
+    /** Serverdan karta (bir qo'ng'iroqda bir marta). Internet bo'lmasa — qisqa xabar; qo'ng'iroqqa ta'sir qilmaydi. */
+    static void load(Context ctx, String number) {
+        if (number.isEmpty() || cards.containsKey(number)) return;
+        Context app = ctx.getApplicationContext();
+        NET.execute(() -> {
+            if (cards.containsKey(number)) return;
+            try {
+                PhoneAccess p = PhoneAccess.of(app);
+                if (p.token.isEmpty()) return;
+                cards.put(number, Api.request(p.server, "lookup/?phone=" + URLEncoder.encode(number, "UTF-8"), p.token, null));
+            } catch (Exception e) {
+                try {
+                    cards.put(number, new JSONObject().put("badge", "Ma'lumot olinmadi (internet yoki server)"));
+                } catch (Exception ignored) {
+                    // JSON yaratilmadi — kartasiz davom etamiz
+                }
+            }
+            changed();
+        });
+    }
+}
