+
+/** Qo'ng'iroq ekrani: yuqorida ERP kartasi (kim qo'ng'iroq qilyapti), pastda Google «Telefon»ga o'xshash tugmalar. */
+class InCallActivity : ComponentActivity() {
+    private var proximity: PowerManager.WakeLock? = null
+
+    /** Qo'ng'iroq holati o'zgarganda ekran qayta chiziladi. */
+    private var version by mutableIntStateOf(0)
+    private val changed = Runnable {
+        if (Phone.primary() == null) {
+            setProximity(false)
+            finishAndRemoveTask()
+        } else version++
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setShowWhenLocked(true)
+        setTurnScreenOn(true)
+        val km = getSystemService(KeyguardManager::class.java)
+        if (km?.isKeyguardLocked == true) km.requestDismissKeyguard(this, null)  // parolsiz qulf: yozuv uchun ham ochiq bo'lishi kerak
+        val pm = getSystemService(PowerManager::class.java)
+        if (pm.isWakeLockLevelSupported(PowerManager.PROXIMITY_SCREEN_OFF_WAKE_LOCK))
+            proximity = pm.newWakeLock(PowerManager.PROXIMITY_SCREEN_OFF_WAKE_LOCK, "codial:proximity")
+        val light = SystemBarStyle.light(AndroidColor.TRANSPARENT, AndroidColor.TRANSPARENT)
+        enableEdgeToEdge(statusBarStyle = light, navigationBarStyle = light)
+        setContent { CodialTheme { Surface(Modifier.fillMaxSize()) { Screen() } } }
+    }
+
+    override fun onNewIntent(intent: Intent) {
+        super.onNewIntent(intent)
+        changed.run()
+    }
+
+    override fun onStart() {
+        super.onStart()
+        Phone.listen(changed)
+        changed.run()
+    }
+
+    override fun onStop() {
+        Phone.unlisten(changed)
+        super.onStop()
+    }
+
+    override fun onDestroy() {
+        setProximity(false)
+        super.onDestroy()
+    }
+
+    /** Telefon quloqqa tutilganda ekran o'chadi (tasodifiy bosilmasin). */
+    private fun setProximity(on: Boolean) {
+        val lock = proximity ?: return
+        if (on && !lock.isHeld) lock.acquire(60 * 60 * 1000L)
+        else if (!on && lock.isHeld) lock.release()
+    }
+
+    @Composable
+    private fun Screen() {
+        var second by remember { mutableIntStateOf(0) }
+        LaunchedEffect(Unit) {
+            while (true) {
+                delay(1000)
+                second++
+            }
+        }
+        val stamp = version  // o'qish — o'zgarishda qayta chizish
+        val call = remember(stamp) { Phone.primary() } ?: return
+        val state = call.state
+        var keypad by remember { mutableStateOf(false) }
+        val audio = Phone.service?.callAudioState
+        val muted = audio?.isMuted == true
+        val route = audio?.route ?: CallAudioState.ROUTE_EARPIECE
+        val speaker = route == CallAudioState.ROUTE_SPEAKER
+        val bluetooth = route == CallAudioState.ROUTE_BLUETOOTH
+        setProximity(state != Call.STATE_RINGING && state != Call.STATE_DISCONNECTED && state != Call.STATE_SELECT_PHONE_ACCOUNT && !speaker && !bluetooth && !keypad)
+
+        val number = Phone.number(call)
+        val data = Phone.card(number)
+        val title = data?.optString("title").orEmpty().ifEmpty { prettyNumber(number) }
+        val badge = if (data == null) "Ma'lumot olinmoqda…" else data.optString("badge")
+
+        Column(Modifier.fillMaxSize().safeDrawingPadding().padding(16.dp), horizontalAlignment = Alignment.CenterHorizontally) {
+            Column(Modifier.weight(1f).fillMaxWidth().verticalScroll(rememberScrollState()), horizontalAlignment = Alignment.CenterHorizontally) {
+                Text(stateText(call, second), color = Palette.muted, fontSize = 15.sp)
+                Spacer(Modifier.height(12.dp))
+                if (!keypad) {
+                    Avatar(title, numberKey(number), 76.dp)
+                    Spacer(Modifier.height(10.dp))
+                }
+                Text(title, fontSize = 28.sp, textAlign = TextAlign.Center)
+                Text(prettyNumber(number), color = Palette.muted, fontSize = 15.sp)
+                val lines = data?.optJSONArray("lines")
+                if (!keypad) {
+                    Card(Modifier.fillMaxWidth().padding(top = 14.dp), colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer)) {
+                        Column(Modifier.padding(14.dp)) {
+                            Text(badge, color = Palette.orange, fontWeight = FontWeight.Bold, fontSize = 15.sp)
+                            if (lines != null) for (i in 0 until lines.length()) Text(lines.optString(i), fontSize = 16.sp, modifier = Modifier.padding(top = 5.dp))
+                        }
+                    }
+                }
+                Phone.other(call)?.let { other ->
+                    val o = Phone.card(Phone.number(other))
+                    val name = o?.optString("title").orEmpty().ifEmpty { prettyNumber(Phone.number(other)) }
+                    Text(
+                        "Ikkinchi qo'ng'iroq: $name" + if (other.state == Call.STATE_HOLDING) " (kutmoqda)" else "",
+                        color = Palette.muted, fontSize = 15.sp, modifier = Modifier.padding(top = 10.dp),
+                    )
+                }
+            }
+            when (state) {
+                Call.STATE_RINGING -> Row(Modifier.fillMaxWidth().padding(vertical = 24.dp), horizontalArrangement = Arrangement.SpaceEvenly) {
+                    Round(Icons.Filled.CallEnd, "Rad etish", Palette.red, Color.White, 76) { call.reject(false, null) }
+                    Round(Icons.Filled.Call, "Javob berish", Palette.green, Color.White, 76) { call.answer(VideoProfile.STATE_AUDIO_ONLY) }
+                }
+                Call.STATE_SELECT_PHONE_ACCOUNT -> SimChoice(call)
+                else -> {
+                    if (keypad) Keypad(call)
+                    val other = Phone.other(call)
+                    val hasBt = audio != null && audio.supportedRouteMask and CallAudioState.ROUTE_BLUETOOTH != 0
+                    Row(Modifier.fillMaxWidth().padding(top = 12.dp), horizontalArrangement = Arrangement.SpaceEvenly) {
+                        Toggle(Icons.Filled.MicOff, "Mikrofon", muted) { Phone.service?.setMuted(!muted) }
+                        Toggle(Icons.Filled.Dialpad, "Raqamlar", keypad) { keypad = !keypad }
+                        Toggle(Icons.AutoMirrored.Filled.VolumeUp, "Karnay", speaker) {
+                            Phone.service?.setAudioRoute(if (speaker) CallAudioState.ROUTE_WIRED_OR_EARPIECE else CallAudioState.ROUTE_SPEAKER)
+                        }
+                        Toggle(Icons.Filled.Pause, "Ushlab turish", state == Call.STATE_HOLDING) {
+                            if (call.state == Call.STATE_HOLDING) call.unhold() else call.hold()
+                        }
+                    }
+                    if (hasBt || other?.state == Call.STATE_HOLDING) {
+                        Row(Modifier.fillMaxWidth().padding(top = 8.dp), horizontalArrangement = Arrangement.SpaceEvenly) {
+                            if (hasBt) Toggle(Icons.Filled.Bluetooth, "Bluetooth", bluetooth) {
+                                Phone.service?.setAudioRoute(if (bluetooth) CallAudioState.ROUTE_WIRED_OR_EARPIECE else CallAudioState.ROUTE_BLUETOOTH)
+                            }
+                            if (other?.state == Call.STATE_HOLDING) Toggle(Icons.Filled.SwapCalls, "Almashtirish", false) { other.unhold() }
+                        }
+                    }
+                    Box(Modifier.padding(vertical = 18.dp)) { Round(Icons.Filled.CallEnd, "Tugatish", Palette.red, Color.White, 72) { call.disconnect() } }
+                }
+            }
+        }
+    }
+
+    private fun stateText(c: Call, tick: Int): String = when (c.state) {
+        Call.STATE_RINGING -> "Kiruvchi qo'ng'iroq"
+        Call.STATE_DIALING, Call.STATE_CONNECTING -> "Terilmoqda…"
+        Call.STATE_ACTIVE -> {
+            val start = c.details.connectTimeMillis
+            val sec = if (start > 0) maxOf(0L, (System.currentTimeMillis() - start) / 1000) else 0L
+            String.format(Locale.US, "Suhbat %02d:%02d", sec / 60, sec % 60).also { check(tick >= 0) }
+        }
+        Call.STATE_HOLDING -> "Ushlab turilibdi"
+        Call.STATE_DISCONNECTING, Call.STATE_DISCONNECTED -> "Qo'ng'iroq tugadi"
+        Call.STATE_SELECT_PHONE_ACCOUNT -> "SIM kartani tanlang"
+        else -> ""
+    }
+
+    @Composable
+    private fun SimChoice(call: Call) {
+        val tm = getSystemService(TelecomManager::class.java)
+        val accounts = remember { runCatching { tm.callCapablePhoneAccounts.map { it to (tm.getPhoneAccount(it)?.label?.toString() ?: "SIM") } }.getOrDefault(emptyList()) }
+        Column(Modifier.fillMaxWidth().padding(vertical = 12.dp), horizontalAlignment = Alignment.CenterHorizontally) {
+            if (accounts.isEmpty()) Text("SIM ro'yxatiga ruxsat yo'q", color = Palette.muted)
+            for ((handle, label) in accounts) Button(onClick = { call.phoneAccountSelected(handle, false) }, modifier = Modifier.fillMaxWidth().padding(4.dp)) { Text(label, fontSize = 17.sp) }
+            Spacer(Modifier.height(10.dp))
+            Round(Icons.Filled.CallEnd, "Bekor qilish", Palette.red, Color.White, 64) { call.disconnect() }
+        }
+    }
+
+    @Composable
+    private fun Keypad(call: Call) {
+        for (line in listOf("123", "456", "789", "*0#")) {
+            Row(Modifier.fillMaxWidth().padding(horizontal = 32.dp, vertical = 3.dp), horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                for (key in line) {
+                    Box(
+                        Modifier.weight(1f).height(52.dp).clip(RoundedCornerShape(26.dp)).background(MaterialTheme.colorScheme.surfaceContainer)
+                            .pointerInput(key) {
+                                detectTapGestures(onPress = {
+                                    call.playDtmfTone(key)
+                                    tryAwaitRelease()
+                                    call.stopDtmfTone()
+                                })
+                            },
+                        contentAlignment = Alignment.Center,
+                    ) { Text(key.toString(), fontSize = 24.sp) }
+                }
+            }
+        }
+    }
+
+    @Composable
+    private fun Toggle(icon: ImageVector, label: String, on: Boolean, onClick: () -> Unit) =
+        Round(icon, label, if (on) Palette.blue else Palette.panel, if (on) Color.White else Palette.text, 62, onClick)
+
+    @Composable
+    private fun Round(icon: ImageVector, label: String, background: Color, tint: Color, size: Int, onClick: () -> Unit) {
+        Column(Modifier.width(88.dp), horizontalAlignment = Alignment.CenterHorizontally) {
+            Box(Modifier.size(size.dp).clip(CircleShape).background(background).clickable(onClick = onClick), contentAlignment = Alignment.Center) {
+                Icon(icon, contentDescription = label, tint = tint, modifier = Modifier.size((size * 0.45f).dp))
+            }
+            Spacer(Modifier.height(6.dp))
+            Text(label, fontSize = 12.sp, color = Palette.text, textAlign = TextAlign.Center, maxLines = 2)
+        }
+    }
+}
