+private fun dayLabel(date: Long): String {
+    if (DateUtils.isToday(date)) return "Bugun"
+    if (DateUtils.isToday(date + DateUtils.DAY_IN_MILLIS)) return "Kecha"
+    val c = Calendar.getInstance().apply { timeInMillis = date }
+    return "${c.get(Calendar.DAY_OF_MONTH)}-${MONTHS[c.get(Calendar.MONTH)]}"
+}
