+            }
+        }
+        item { Header(if (history.isEmpty()) "Bu raqam bilan qo'ng'iroq bo'lmagan" else "Qo'ng'iroqlar tarixi (${history.size})") }
+        items(history) { e ->
+            val (icon, color) = typeIcon(e.type)
+            Row(Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 9.dp), verticalAlignment = Alignment.CenterVertically) {
+                Icon(icon, contentDescription = null, tint = color, modifier = Modifier.size(20.dp))
+                Spacer(Modifier.width(16.dp))
+                Column(Modifier.weight(1f)) {
+                    Text(typeName(e), fontSize = 15.sp)
+                    Text("${dayLabel(e.date)}, ${clock(e.date)}", color = Palette.muted, fontSize = 13.sp)
+                }
+                Text(length(e.duration), color = Palette.muted, fontSize = 13.sp)
+            }
+        }
+        item { Spacer(Modifier.height(24.dp)) }
+    }
+}
