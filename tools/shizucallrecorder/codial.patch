--- /dev/null
+++ b/app/src/main/java/uz/codial/calls/phone/CodialInCallService.java
@@ -0,0 +1,140 @@
+package uz.codial.calls.phone;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Intent;
+import android.telecom.Call;
+import android.telecom.CallAudioState;
+import android.telecom.InCallService;
+import android.util.Log;
+
+import org.json.JSONObject;
+
+/**
+ * Asosiy qo'ng'iroq ilovasi xizmati: tizim har qo'ng'iroqda shu xizmatni o'zi ishga tushiradi.
+ * Qo'ng'iroq ekrani (InCallActivity) va bildirishnomani boshqaradi; jiringlash ovozini tizim chaladi.
+ */
+public class CodialInCallService extends InCallService {
+    private static final String TAG = "CodialPhone";
+    private static final String CHANNEL = "codial_calls";
+    private static final int NOTE = 7702;
+
+    private final Call.Callback callback = new Call.Callback() {
+        @Override
+        public void onStateChanged(Call call, int state) { update(); }
+
+        @Override
+        public void onDetailsChanged(Call call, Call.Details details) {
+            Phone.load(CodialInCallService.this, Phone.number(call));
+            update();
+        }
+    };
+
+    private final Runnable refresh = this::notifyCall;
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        Phone.service = this;
+        NotificationChannel ch = new NotificationChannel(CHANNEL, "Qo'ng'iroq ekrani", NotificationManager.IMPORTANCE_HIGH);
+        ch.setSound(null, null);  // jiringlashni tizim chaladi
+        ch.enableVibration(false);
+        getSystemService(NotificationManager.class).createNotificationChannel(ch);
+        Phone.listen(refresh);
+    }
+
+    @Override
+    public void onDestroy() {
+        Phone.unlisten(refresh);
+        getSystemService(NotificationManager.class).cancel(NOTE);
+        Phone.calls.clear();
+        Phone.service = null;
+        Phone.changed();
+        super.onDestroy();
+    }
+
+    @Override
+    public void onCallAdded(Call call) {
+        super.onCallAdded(call);
+        if (!Phone.calls.contains(call)) Phone.calls.add(call);
+        call.registerCallback(callback);
+        Phone.load(this, Phone.number(call));
+        update();
+        showScreen();
+    }
+
+    @Override
+    public void onCallRemoved(Call call) {
+        super.onCallRemoved(call);
+        call.unregisterCallback(callback);
+        Phone.calls.remove(call);
+        Phone.forget(Phone.number(call));
+        update();
+    }
+
+    @Override
+    public void onCallAudioStateChanged(CallAudioState state) {
+        super.onCallAudioStateChanged(state);
+        Phone.changed();
+    }
+
+    @Override
+    public void onBringToForeground(boolean showDialpad) {
+        super.onBringToForeground(showDialpad);
+        showScreen();
+    }
+
+    private void update() {
+        Phone.changed();
+        notifyCall();
+    }
+
+    private void showScreen() {
+        try {
+            startActivity(new Intent(this, InCallActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Qo'ng'iroq ekrani ochilmadi", e);  // bildirishnoma orqali ochiladi
+        }
+    }
+
+    private PendingIntent action(String name, int code) {
+        return PendingIntent.getBroadcast(this, code, new Intent(this, PhoneActionReceiver.class).setAction(name), PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+    }
+
+    private void notifyCall() {
+        NotificationManager nm = getSystemService(NotificationManager.class);
+        Call c = Phone.primary();
+        if (c == null || c.getState() == Call.STATE_DISCONNECTED) {
+            if (c == null) nm.cancel(NOTE);
+            return;
+        }
+        boolean ringing = c.getState() == Call.STATE_RINGING;
+        String number = Phone.number(c);
+        JSONObject card = Phone.card(number);
+        String title = card != null && card.has("title") ? card.optString("title") : (number.isEmpty() ? "Yashirin raqam" : number);
+        String text = card != null ? card.optString("badge") : (ringing ? "Kiruvchi qo'ng'iroq" : "Qo'ng'iroq");
+        PendingIntent open = PendingIntent.getActivity(this, 1, new Intent(this, InCallActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK), PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+        Notification.Builder b = new Notification.Builder(this, CHANNEL)
+                .setSmallIcon(android.R.drawable.sym_action_call)
+                .setContentTitle(title)
+                .setContentText(text)
+                .setCategory(Notification.CATEGORY_CALL)
+                .setOngoing(true)
+                .setOnlyAlertOnce(true)
+                .setContentIntent(open);
+        if (ringing) {
+            b.setFullScreenIntent(open, true);
+            b.addAction(new Notification.Action.Builder(null, "Rad etish", action(PhoneActionReceiver.REJECT, 2)).build());
+            b.addAction(new Notification.Action.Builder(null, "Javob berish", action(PhoneActionReceiver.ANSWER, 3)).build());
+        } else {
+            b.addAction(new Notification.Action.Builder(null, "Tugatish", action(PhoneActionReceiver.HANGUP, 4)).build());
+        }
+        try {
+            nm.notify(NOTE, b.build());
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Bildirishnoma ko'rsatilmadi", e);
+        }
+    }
+}
