+/** Ketma-ket kelgan bir xil raqamli (bir kundagi) qo'ng'iroqlar bitta qatorga yig'iladi. */
+private data class Group(val first: CallEntry, val count: Int, val day: String)
+
+private fun group(calls: List<CallEntry>): List<Group> {
+    val out = ArrayList<Group>()
+    for (e in calls) {
+        val day = dayLabel(e.date)
+        val last = out.lastOrNull()
+        if (last != null && last.day == day && numberKey(last.first.number) == numberKey(e.number) && isMissed(last.first.type) == isMissed(e.type)) {
+            out[out.size - 1] = last.copy(count = last.count + 1)
+        } else out.add(Group(e, 1, day))
+    }
+    return out
+}
