@@ -0,0 +1,47 @@
+package uz.codial.calls;
+
+import android.app.Activity;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.telephony.SmsMessage;
+
+/**
+ * Yetkazilish hisoboti (operator qabul qiluvchiga yetganini yoki yetmaganini xabar qiladi). Hamma operator yubormaydi — kelmasa,
+ * ERP'da «yetkazilishi noma'lum» turadi. Holat kodi (3GPP): 0 — yetkazildi, 0x20–0x3F — vaqtincha kechikish (yakuniy hisobot keyin keladi),
+ * 0x40 va undan katta — yetkazilmadi.
+ */
+public class SmsDeliveredReceiver extends BroadcastReceiver {
+    @Override
+    public void onReceive(Context ctx, Intent intent) {
+        String id = intent.getStringExtra("id");
+        if (id == null) return;
+        boolean ok = getResultCode() == Activity.RESULT_OK;
+        String detail = "";
+        byte[] pdu = intent.getByteArrayExtra("pdu");
+        if (pdu != null) {
+            try {
+                int st = SmsMessage.createFromPdu(pdu, intent.getStringExtra("format")).getStatus();
+                detail = "holat 0x" + Integer.toHexString(st);
+                if (st >= 0x20 && st < 0x40) return;  // vaqtincha — yakuniy hisobotni kutamiz
+                ok = st == 0;
+            } catch (RuntimeException ignored) {
+                // pdu o'qilmadi — natija kodiga tayanamiz
+            }
+        }
+        boolean last = intent.getIntExtra("part", 0) >= intent.getIntExtra("total", 1) - 1;
+        if (ok && !last) return;
+        String base = intent.getStringExtra("info");
+        String info = ((base == null ? "" : base) + (detail.isEmpty() ? "" : " · " + detail)).trim();
+        String error = ok ? "" : "Qabul qiluvchiga yetmadi (" + (detail.isEmpty() ? "operator xabari" : detail) + ")";
+        boolean fOk = ok;
+        PendingResult async = goAsync();
+        new Thread(() -> {
+            try {
+                SmsSender.report(ctx.getApplicationContext(), id, fOk, error, "delivered", info);
+            } finally {
+                async.finish();
+            }
+        }).start();
+    }
+}
diff --git a/app/src/main/java/uz/codial/calls/SmsInbox.java b/app/src/main/java/uz/codial/calls/SmsInbox.java
new file mode 100644
index 0000000..3dd7be7
--- /dev/null
+++ b/app/src/main/java/uz/codial/calls/SmsInbox.java
@@ -0,0 +1,105 @@
+package uz.codial.calls;
+
+import android.Manifest;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.database.Cursor;
+import android.provider.Telephony;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Mijozlardan kelgan SMS (1.2, 2026-10-22): «Kirish qutisi»dan yangi xabarlarni o'qib `POST /api/v1/calls/sms/inbox/` ga yuboradi.
+ * Faqat oddiy telefon raqamlaridan (+998 XX XXX XX XX) kelganlar — qisqa raqam va nomli yuboruvchilar (bank kodlari, Click, Payme,
+ * operator) telefondan chiqmaydi. Yangilari SMS _ID bo'yicha; sutkada bir marta oxirgi 24 soat qayta yuboriladi (server takrorni
+ * qabul qilmaydi). Birinchi marta — shu kunning boshidan.
+ */
+final class SmsInbox {
+    private static final ExecutorService EXEC = Executors.newSingleThreadExecutor();
+    private static final int BATCH = 200;
+
+    private SmsInbox() {}
+
+    static boolean allowed(Context ctx) {
+        return ctx.checkSelfPermission(Manifest.permission.READ_SMS) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    static void request(Context ctx) {
+        Context app = ctx.getApplicationContext();
+        EXEC.execute(() -> run(app));
+    }
+
+    /** Fon oqimida. Natija: server qabul qilganlar soni yoki -1 xato bo'lsa. */
+    static synchronized int run(Context ctx) {
+        Prefs p = new Prefs(ctx);
+        if (!p.paired() || !allowed(ctx)) return 0;
+        long now = System.currentTimeMillis();
+        long lastId = p.smsInLastId();
+        boolean full = lastId > 0 && now - p.smsInFullAt() > CallSync.FULL_SCAN_MS;
+        // Birinchi marta (_ID hali yo'q) — shu kun boshidan; sutkada bir marta — oxirgi 24 soat; aks holda faqat yangi _ID'lar
+        long dateFrom = lastId == 0 ? p.smsInFrom() : full ? now - CallSync.FULL_SCAN_MS : Long.MAX_VALUE;
+        int total = 0;
+        try {
+            boolean first = true;
+            while (true) {
+                JSONArray msgs = new JSONArray();
+                long[] r = read(ctx, lastId > 0 ? lastId : Long.MAX_VALUE, first ? dateFrom : Long.MAX_VALUE, msgs);
+                if (msgs.length() > 0) {
+                    JSONObject res = Api.request(p.server(), "sms/inbox/", p.token(), new JSONObject().put("messages", msgs));
+                    total += res.optInt("accepted");
+                    p.smsInAccepted(res.optInt("accepted"));
+                }
+                lastId = Math.max(lastId, r[0]);
+                p.smsInSynced(lastId, full && first);
+                if (r[1] < BATCH) break;
+                first = false;  // keyingi to'plam — faqat _ID bo'yicha
+            }
+            return total;
+        } catch (Api.HttpError e) {
+            if (e.deviceRevoked()) p.unpair("Ulanish bekor qilingan — ERP'dan yangi kod olib qayta ulang");
+            else p.smsError(e.getMessage());
+            return -1;
+        } catch (IOException | JSONException | SecurityException e) {
+            p.smsError("Kelgan SMS yuborilmadi: " + e.getMessage());
+            return -1;
+        }
+    }
+
+    /**
+     * `_ID > afterId` yoki `DATE > dateFrom` xabarlar (_ID tartibida, ko'pi BATCH ta); oddiy raqamlardan kelganlari `out` ga.
+     * Qaytaradi: {ko'rilgan eng katta _ID (filtrdan o'tmaganlari ham — qayta o'qilmasin), ko'rilganlar soni}.
+     */
+    private static long[] read(Context ctx, long afterId, long dateFrom, JSONArray out) throws JSONException {
+        String[] cols = {Telephony.Sms._ID, Telephony.Sms.ADDRESS, Telephony.Sms.DATE, Telephony.Sms.BODY};
+        long maxId = 0;
+        int seen = 0;
+        String where = Telephony.Sms._ID + " > ? OR " + Telephony.Sms.DATE + " > ?";
+        try (Cursor c = ctx.getContentResolver().query(Telephony.Sms.Inbox.CONTENT_URI, cols, where,
+                new String[]{String.valueOf(afterId), String.valueOf(dateFrom)}, Telephony.Sms._ID + " ASC")) {
+            if (c == null) return new long[]{0, 0};
+            while (c.moveToNext() && seen < BATCH) {
+                seen++;
+                maxId = Math.max(maxId, c.getLong(0));
+                String address = c.getString(1);
+                if (!isPhone(address)) continue;
+                String body = c.getString(3);
+                out.put(new JSONObject().put("id", c.getLong(0)).put("address", address).put("date", c.getLong(2))
+                        .put("body", body == null ? "" : body));
+            }
+        }
+        return new long[]{maxId, seen};
+    }
+
+    /** Oddiy O'zbekiston raqami: 9 raqam yoki 998 + 9 raqam (bo'shliq, «+», «-» hisobga olinmaydi); harf bo'lsa — yo'q. */
+    static boolean isPhone(String address) {
+        if (address == null || address.matches(".*[A-Za-z].*")) return false;
+        String d = address.replaceAll("\\D", "");
+        return d.length() == 9 || (d.length() == 12 && d.startsWith("998"));
+    }
+}
diff --git a/app/src/main/java/uz/codial/calls/SmsReceivedReceiver.java b/app/src/main/java/uz/codial/calls/SmsReceivedReceiver.java
new file mode 100644
index 0000000..2091c01
--- /dev/null
+++ b/app/src/main/java/uz/codial/calls/SmsReceivedReceiver.java
@@ -0,0 +1,21 @@
+package uz.codial.calls;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Handler;
+import android.os.Looper;
+
+/** SMS kelganda — kirish qutisiga yozilishini biroz kutib ERP'ga yuboradi; xizmat to'xtab qolgan bo'lsa qayta yoqadi. */
+public class SmsReceivedReceiver extends BroadcastReceiver {
+    @Override
+    public void onReceive(Context ctx, Intent intent) {
+        Context app = ctx.getApplicationContext();
+        PendingResult pending = goAsync();
+        new Handler(Looper.getMainLooper()).postDelayed(() -> {
+            CallService.start(app);
+            SmsInbox.request(app);
+            pending.finish();
+        }, 3000);
+    }
+}
diff --git a/app/src/main/java/uz/codial/calls/SmsSender.java b/app/src/main/java/uz/codial/calls/SmsSender.java
new file mode 100644
index 0000000..5678c33
--- /dev/null
+++ b/app/src/main/java/uz/codial/calls/SmsSender.java
@@ -0,0 +1,183 @@
+package uz.codial.calls;
+
+import android.Manifest;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Build;
+import android.os.PowerManager;
+import android.telephony.SmsManager;
+import android.telephony.SubscriptionInfo;
+import android.telephony.SubscriptionManager;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * SMS navbati (2026-10-22): ERP'da administrator «Yuborish»ni bosgan to'lov eslatmalarini serverdan olib, shu telefonning SIM'idan yuboradi.
+ * Server bergan xabar «Yuborilmoqda» bo'ladi — qayta berilmaydi. Natija (yuborildi / xato) {@link SmsSentReceiver} orqali qaytariladi;
+ * internet bo'lmasa natija saqlanib, keyingi urinishda yuboriladi. Operator spam deb to'xtatmasligi uchun xabarlar orasida pauza.
+ */
+final class SmsSender {
+    static final String ACTION_SENT = "uz.codial.calls.SMS_SENT";
+    static final String ACTION_DELIVERED = "uz.codial.calls.SMS_DELIVERED";
+    private static final ExecutorService EXEC = Executors.newSingleThreadExecutor();
+    private static final AtomicBoolean BUSY = new AtomicBoolean(false);
+    private static final long PAUSE_MS = 4000;
+    private static final int MAX_ROUNDS = 10;
+
+    private SmsSender() {}
+
+    /** Har 30 soniyada chaqiriladi; yuborish davom etayotgan bo'lsa (pauzalar bilan bir necha daqiqa) — yangisi navbatga qo'shilmaydi. */
+    static void request(Context ctx) {
+        Context app = ctx.getApplicationContext();
+        if (!BUSY.compareAndSet(false, true)) return;
+        EXEC.execute(() -> {
+            try {
+                run(app);
+            } finally {
+                BUSY.set(false);
+            }
+        });
+    }
+
+    static boolean allowed(Context ctx) {
+        return ctx.checkSelfPermission(Manifest.permission.SEND_SMS) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    /** Fon oqimida. Natija: yuborishga berilgan SMS soni yoki -1 xato bo'lsa. */
+    static synchronized int run(Context ctx) {
+        Prefs p = new Prefs(ctx);
+        if (!p.paired()) return 0;
+        flushReports(ctx);
+        if (!allowed(ctx)) {
+            p.smsError("SMS yuborishga ruxsat berilmagan");
+            return -1;
+        }
+        p.smsClearTransientError();  // ruxsat bor — «ruxsat berilmagan» degan eski yozuv o'chadi
+        int total = 0;
+        PowerManager.WakeLock lock = null;
+        try {
+            for (int round = 0; round < MAX_ROUNDS; round++) {
+                JSONArray msgs = Api.request(p.server(), "sms/outbox/", p.token(), null).optJSONArray("messages");
+                p.smsClearTransientError();
+                if (msgs == null || msgs.length() == 0) break;
+                if (lock == null) {  // yuborish (pauzalar bilan) davomida ekran o'chiq bo'lsa ham protsessor uxlamasin
+                    lock = ctx.getSystemService(PowerManager.class).newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "codial:sms");
+                    lock.acquire(15 * 60_000L);
+                }
+                for (int i = 0; i < msgs.length(); i++) {
+                    JSONObject m = msgs.getJSONObject(i);
+                    send(ctx, m.getString("id"), m.getString("phone"), m.getString("text"));
+                    total++;
+                    Thread.sleep(PAUSE_MS);
+                }
+            }
+            if (total > 0) p.smsQueued(total);
+            return total;
+        } catch (Api.HttpError e) {
+            if (e.deviceRevoked()) p.unpair("Ulanish bekor qilingan — ERP'dan yangi kod olib qayta ulang");
+            else p.smsError(e.getMessage());
+            return -1;
+        } catch (IOException | JSONException e) {
+            p.smsError("Internet yoki server bilan aloqa yo'q: " + e.getMessage());
+            return -1;
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return total;
+        } finally {
+            if (lock != null && lock.isHeld()) lock.release();
+        }
+    }
+
+    private static void send(Context ctx, String id, String phone, String text) {
+        String info = "";
+        try {
+            // Tizimdagi «SMS uchun SIM» aniq ko'rsatiladi; qaysi SIM va operator ekani ERP'da ko'rinadi
+            int subId = SubscriptionManager.getDefaultSmsSubscriptionId();
+            SmsManager sm = Build.VERSION.SDK_INT >= 31 ? ctx.getSystemService(SmsManager.class) : SmsManager.getDefault();
+            if (subId != SubscriptionManager.INVALID_SUBSCRIPTION_ID) {
+                sm = Build.VERSION.SDK_INT >= 31 ? sm.createForSubscriptionId(subId) : SmsManager.getSmsManagerForSubscriptionId(subId);
+            }
+            info = simInfo(ctx, subId);
+            ArrayList<String> parts = sm.divideMessage(text);
+            ArrayList<PendingIntent> sent = new ArrayList<>();
+            ArrayList<PendingIntent> delivered = new ArrayList<>();
+            for (int i = 0; i < parts.size(); i++) {
+                sent.add(resultIntent(ctx, SmsSentReceiver.class, ACTION_SENT, id, i, parts.size(), info));
+                delivered.add(resultIntent(ctx, SmsDeliveredReceiver.class, ACTION_DELIVERED, id, i, parts.size(), info));
+            }
+            if (parts.size() == 1) sm.sendTextMessage(phone, null, text, sent.get(0), delivered.get(0));
+            else sm.sendMultipartTextMessage(phone, null, parts, sent, delivered);
+        } catch (RuntimeException e) {  // SecurityException, IllegalArgumentException — darhol xato
+            report(ctx, id, false, "Telefon yubora olmadi: " + e.getMessage(), "sent", info);
+        }
+    }
+
+    /** Operator natijasi qaytadigan intent. MUTABLE: tizim `errorCode` (yuborish xatosi) va `pdu` (yetkazilish holati) ni shu intentga qo'shadi. */
+    private static PendingIntent resultIntent(Context ctx, Class<?> receiver, String action, String id, int part, int total, String info) {
+        Intent i = new Intent(ctx, receiver).setAction(action)
+                .putExtra("id", id).putExtra("part", part).putExtra("total", total).putExtra("info", info);
+        int flags = PendingIntent.FLAG_ONE_SHOT | (Build.VERSION.SDK_INT >= 31 ? PendingIntent.FLAG_MUTABLE : 0);
+        return PendingIntent.getBroadcast(ctx, (action + id + "#" + part).hashCode(), i, flags);
+    }
+
+    private static String simInfo(Context ctx, int subId) {
+        try {
+            SubscriptionManager sub = ctx.getSystemService(SubscriptionManager.class);
+            SubscriptionInfo si = sub.getActiveSubscriptionInfo(subId);
+            int count = sub.getActiveSubscriptionInfoCount();
+            if (si == null) return "SIM aniqlanmadi";
+            return "SIM " + (si.getSimSlotIndex() + 1) + " · " + si.getCarrierName() + (count > 1 ? " (" + count + " SIM)" : "");
+        } catch (RuntimeException e) {
+            return "";
+        }
+    }
+
+    /** Natijani serverga yuboradi; internet bo'lmasa saqlab qo'yadi (keyingi `run` da qayta). stage: "sent" yoki "delivered". */
+    static void report(Context ctx, String id, boolean ok, String error, String stage, String info) {
+        Prefs p = new Prefs(ctx);
+        try {
+            p.addPendingReport(new JSONObject().put("id", id).put("ok", ok).put("error", error == null ? "" : error)
+                    .put("stage", stage).put("info", info == null ? "" : info));
+        } catch (JSONException ignored) {
+            return;
+        }
+        if ("delivered".equals(stage)) {
+            if (ok) p.smsDelivered();
+        } else if (ok) {
+            p.smsSent();
+        } else {
+            p.smsError(error);
+        }
+        flushReports(ctx);
+    }
+
+    private static final Object REPORT_LOCK = new Object();
+
+    static void flushReports(Context ctx) {
+        synchronized (REPORT_LOCK) {
+            flushLocked(ctx);
+        }
+    }
+
+    private static void flushLocked(Context ctx) {
+        Prefs p = new Prefs(ctx);
+        JSONArray pending = p.pendingReports();
+        if (pending.length() == 0 || !p.paired()) return;
+        try {
+            Api.request(p.server(), "sms/report/", p.token(), new JSONObject().put("results", pending));
+            p.clearPendingReports(pending.length());
+        } catch (IOException | JSONException ignored) {
+            // keyingi urinishda
+        }
+    }
+}
