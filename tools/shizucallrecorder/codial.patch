+/** Telefonning o'zidagi mosliklar: kontaktlar va qo'ng'iroqlar tarixi (ism yoki raqamning istalgan qismi). */
+private fun localHits(query: String, calls: List<CallEntry>, contacts: List<ContactEntry>, book: Map<String, ContactEntry>, limit: Int): List<Hit> {
+    val q = query.trim()
+    if (q.isEmpty()) return emptyList()
+    val digits = q.filter { it.isDigit() }
+    val byNumber = digits.isNotEmpty() && q.all { it.isDigit() || it in "+ -()*#" }
+    val out = LinkedHashMap<String, Hit>()
+    fun add(title: String, subtitle: String, number: String) {
+        val key = numberKey(number)
+        if (key.isEmpty() || out.size >= limit || key in out) return
+        val name = Erp.names[key]?.title ?: title
+        val matches = if (byNumber) number.filter { it.isDigit() }.contains(digits) else name.contains(q, true) || title.contains(q, true)
+        if (matches) out[key] = Hit(name, subtitle, number)
+    }
+    for (e in calls) add(titleOf(e.number, e.cachedName, book), Erp.names[numberKey(e.number)]?.badge ?: prettyNumber(e.number), e.number)
+    for (c in contacts) add(c.name, prettyNumber(c.number), c.number)
+    return out.values.toList()
+}
