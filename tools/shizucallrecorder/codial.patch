+private fun isMissed(type: Int) = type == CallLog.Calls.MISSED_TYPE || type == CallLog.Calls.REJECTED_TYPE
+
+private fun typeName(e: CallEntry) = when (e.type) {
+    CallLog.Calls.OUTGOING_TYPE -> if (e.duration > 0) "Chiquvchi" else "Chiquvchi, javob bo'lmadi"
+    CallLog.Calls.MISSED_TYPE -> "Javobsiz"
+    CallLog.Calls.REJECTED_TYPE -> "Rad etilgan"
+    CallLog.Calls.BLOCKED_TYPE -> "Bloklangan"
+    else -> "Kiruvchi"
+}
