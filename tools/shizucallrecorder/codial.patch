+/** Yorug' ko'rinish — Google «Telefon»ga o'xshash ranglar. */
+object Palette {
+    val blue = Color(0xFF0B57D0)
+    val blueSoft = Color(0xFFD3E3FD)
+    val background = Color(0xFFFFFFFF)
+    val panel = Color(0xFFF0F4F9)
+    val text = Color(0xFF1F1F1F)
+    val muted = Color(0xFF5F6368)
+    val green = Color(0xFF188038)
+    val red = Color(0xFFD93025)
+    val orange = Color(0xFFE8710A)
+    val avatars = listOf(Color(0xFF1A73E8), Color(0xFF9334E6), Color(0xFF188038), Color(0xFFE8710A), Color(0xFFC5221F), Color(0xFF007B83))
+}
+
+@Composable
+fun CodialTheme(content: @Composable () -> Unit) {
+    MaterialTheme(
+        colorScheme = lightColorScheme(
+            primary = Palette.blue, onPrimary = Color.White, primaryContainer = Palette.blueSoft, onPrimaryContainer = Color(0xFF041E49),
+            secondaryContainer = Palette.blueSoft, onSecondaryContainer = Color(0xFF041E49),
+            background = Palette.background, onBackground = Palette.text, surface = Palette.background, onSurface = Palette.text,
+            surfaceVariant = Palette.panel, onSurfaceVariant = Palette.muted,
+            surfaceContainer = Palette.panel, surfaceContainerHigh = Color(0xFFE9EEF6), surfaceContainerLow = Color(0xFFF8FAFD),
+        ),
+        content = content,
+    )
+}
+
+/** Dumaloq rasm o'rnida: ismning birinchi harfi yoki odam belgisi. */
+@Composable
+fun Avatar(name: String, key: String, size: Dp = 42.dp, onClick: (() -> Unit)? = null) {
+    val letter = name.trim().firstOrNull()?.takeIf { it.isLetter() }
+    val color = Palette.avatars[Math.floorMod(key.hashCode(), Palette.avatars.size)]
+    var m = Modifier.size(size).clip(CircleShape).background(color)
+    if (onClick != null) m = m.clickable(onClick = onClick)
+    Box(m, contentAlignment = Alignment.Center) {
+        if (letter != null) Text(letter.uppercase(), color = Color.White, fontSize = (size.value * 0.45f).sp)
+        else Icon(Icons.Filled.Person, contentDescription = null, tint = Color.White, modifier = Modifier.size(size * 0.6f))
+    }
+}
