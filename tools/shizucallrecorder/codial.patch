+    var loading by remember { mutableStateOf(false) }
+    LaunchedEffect(query) {
+        erp = emptyList()
+        loading = query.trim().length >= 3
+        if (loading) {
+            delay(400)
+            erp = Erp.search(ctx, query)
+            loading = false
+        }
+    }
+    val local = remember(query, calls, contacts) { localHits(query, calls, contacts, book, 30) }
+    val remote = erp.orEmpty().filter { r -> local.none { numberKey(it.number) == numberKey(r.number) } }
+    LazyColumn(Modifier.fillMaxSize()) {
+        if (local.isNotEmpty()) item { Header("Telefonda") }
+        items(local) { h -> PersonRow(h.title, numberKey(h.number), details(h), h.number, { onOpen(h.number) }) }
+        if (remote.isNotEmpty()) item { Header("ERP'da") }
+        items(remote) { h -> PersonRow(h.title, numberKey(h.number), details(h), h.number, { onOpen(h.number) }) }
+        item {
+            when {
+                query.trim().length < 3 -> Empty("ERP'dan qidirish uchun kamida 3 ta harf yoki raqam yozing")
+                loading -> Empty("ERP'dan qidirilmoqda…")
+                erp == null -> Empty("ERP'ga ulanib bo'lmadi (internet yoki server)")
+                local.isEmpty() && remote.isEmpty() -> Empty("Hech narsa topilmadi")
+            }
+        }
+    }
+}
