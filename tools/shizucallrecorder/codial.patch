+package uz.codial.calls;
+
+import android.Manifest;
+import android.app.Activity;
+import android.content.ActivityNotFoundException;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.provider.DocumentsContract;
+import android.graphics.Typeface;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.provider.Settings;
+import android.text.InputType;
+import android.view.View;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.json.JSONObject;
+
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Calendar;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.Executors;
+
+/** Bitta ekran: ulash (server + 8 belgili kod), holat, ruxsatlar va MIUI sozlamalari. */
+public class MainActivity extends Activity {
+    private static final java.util.concurrent.ExecutorService BG = Executors.newSingleThreadExecutor();  // har bosishda yangi oqim ochilmasin
+    private static final char LF = (char) 10;
+    private final Handler ui = new Handler(Looper.getMainLooper());
+    private Prefs prefs;
+    private LinearLayout root;
+    private TextView status;
+    private EditText server;
+    private EditText code;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        prefs = new Prefs(this);
+        ScrollView scroll = new ScrollView(this);
+        root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        int pad = dp(16);
+        root.setPadding(pad, pad, pad, pad);
+        scroll.addView(root);
+        setContentView(scroll);
+        build();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        refresh();
+        if (prefs.paired()) {
+            CallService.start(this);
+            SyncJob.schedule(this);
+        }
+    }
+
+    private void build() {
+        TextView title = text("Codial ERP — qo'ng'iroqlar", 20);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        root.addView(title);
+        root.addView(text("Bu telefondagi qo'ng'iroqlar tugashi bilan ERP tizimidagi «Qo'ng'iroqlar» bo'limiga yuboriladi: raqam, vaqt va davomiylik. "
+                + "Suhbat yozuvini bu ilovaning o'zi yozmaydi — telefondagi yozuvchi ilova saqlagan fayllar ERP'ga yuklanadi (4-band). "
+                + "ERP'da administrator «SMS yuborish»ni bossa, to'lov eslatmalari shu telefonning SIM kartasidan yuboriladi. "
+                + "Mijozlardan (oddiy raqamlardan) kelgan SMS'lar ERP'ga tushadi; bank va xizmat SMS'lari yuborilmaydi.", 14));
+
+        status = text("", 15);
+        status.setPadding(0, dp(12), 0, dp(12));
+        root.addView(status);
+
+        root.addView(header("1. Ruxsatlar"));
+        root.addView(button("Ruxsatlarni berish", v -> askPermissions()));
+        root.addView(button("Batareya tejashni o'chirish", v -> batteryExemption()));
+        root.addView(button("MIUI: Avtozapusk (Autostart) yoqish", v -> miuiAutostart()));
+        root.addView(text("Xiaomi/Redmi'da: Sozlamalar → Ilovalar → Codial qo'ng'iroqlar → «Avtozapusk» yoqilgan, "
+                + "«Batareya tejash» → «Cheklovlarsiz» bo'lsin. Oxirgi ilovalar ro'yxatida ilovani qulflab qo'ying (🔒).", 13));
+
+        root.addView(header("2. ERP'ga ulash"));
+        server = new EditText(this);
+        server.setText(prefs.server());
+        server.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        root.addView(label("Server manzili"));
+        root.addView(server);
+        code = new EditText(this);
+        code.setHint("Masalan: ABCD-2345");
+        code.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS);
+        root.addView(label("Ulash kodi (ERP → Qo'ng'iroqlar → Qurilmalar)"));
+        root.addView(code);
+        root.addView(button("Ulash", v -> pair()));
+
+        root.addView(header("3. Tekshirish"));
+        root.addView(button("Hozir yuborish", v -> syncNow()));
+        root.addView(text("SMS ko'p yuborilganda Android «Ilova ko'p SMS yuboryapti» deb so'rashi mumkin — «Doim ruxsat berish» ni belgilab, «Yuborish»ni bosing.", 13));
+
+        root.addView(header("5. Yozuvchi (Shizuku)"));
+        root.addView(text("Suhbatni yozish endi shu ilovaning ichida. Shizuku ilovasi ishlab turishi kerak («Shizuku is running»). "
+                + "Audio manba, avtomatik yozish va papka sozlamalari — pastdagi tugmada.", 13));
+        root.addView(button("Yozuvchi sozlamalari", v -> openRecorderSettings()));
+        root.addView(button("Shizuku ilovasini ochish", v -> openShizuku()));
+
+        root.addView(header("4. Suhbat yozuvlari"));
+        root.addView(text("Yozuvchi ilova (masalan ShizuCallRecorder) suhbatlarni shu telefonda alohida papkaga saqlasin. "
+                + "Papkani shu yerda tanlang — undagi yangi audio fayllar har qo'ng'iroqdan keyin ERP'ga yuklanadi va mos qo'ng'iroqqa biriktiriladi. "
+                + "Papka tanlashda «Yangi papka» yarating (masalan «Yozuvlar»); Download yoki xotira ildizini Android ruxsat bermaydi.", 13));
+        root.addView(button("Yozuvlar papkasini tanlash", v -> pickRecordingsFolder()));
+        root.addView(button("Yozuvlarni hozir yuklash", v -> uploadRecordingsNow()));
+        root.addView(button("Papkani uzish", v -> {
+            prefs.recSetTree(null);
+            refresh();
+        }));
+    }
+
+    private void openRecorderSettings() {
+        try {
+            startActivity(new Intent().setClassName(getPackageName(), "com.kitsumed.shizucallrecorder.MainActivity"));
+        } catch (RuntimeException e) {
+            toast("Yozuvchi ekranini ochib bo'lmadi: " + e.getMessage());
+        }
+    }
+
+    private void openShizuku() {
+        Intent i = getPackageManager().getLaunchIntentForPackage("moe.shizuku.privileged.api");
+        if (i == null) {
+            toast("Shizuku ilovasi o'rnatilmagan");
+            return;
+        }
+        startActivity(i);
+    }
+
+    private void refresh() {
+        StringBuilder s = new StringBuilder();
+        s.append(prefs.paired() ? "✅ Ulangan: " + prefs.deviceName() : "⚠️ ERP'ga ulanmagan").append('\n');
+        s.append(hasCallLog() ? "✅ Qo'ng'iroqlar jurnaliga ruxsat bor" : "⚠️ Qo'ng'iroqlar jurnaliga ruxsat yo'q").append('\n');
+        PowerManager pm = getSystemService(PowerManager.class);
+        s.append(pm.isIgnoringBatteryOptimizations(getPackageName()) ? "✅ Batareya tejash o'chirilgan" : "⚠️ Batareya tejash yoqilgan — ilova to'xtab qolishi mumkin").append('\n');
+        if (prefs.lastSyncAt() > 0) s.append("Oxirgi yuborish: ").append(fmt(prefs.lastSyncAt())).append(" · jami ").append(prefs.sentTotal()).append(" ta\n");
+        if (!prefs.lastError().isEmpty()) s.append("❗ ").append(prefs.lastError()).append('\n');
+        s.append(SmsSender.allowed(this) ? "✅ SMS yuborishga ruxsat bor" : "⚠️ SMS yuborishga ruxsat yo'q — to'lov eslatmalari ketmaydi").append('\n');
+        if (prefs.smsLastAt() > 0) {
+            s.append("SMS: yuborildi ").append(prefs.smsSentTotal()).append(" · yetkazildi ").append(prefs.smsDeliveredTotal())
+                    .append(" · oxirgi ").append(fmt(prefs.smsLastAt())).append('\n');
+        }
+        s.append(SmsInbox.allowed(this) ? "✅ Kelgan SMS'larni o'qishga ruxsat bor" : "⚠️ SMS o'qishga ruxsat yo'q — mijozlardan kelgan SMS ERP'ga tushmaydi").append('\n');
+        if (prefs.smsInTotal() > 0) s.append("Kelgan SMS: jami ").append(prefs.smsInTotal()).append(" ta ERP'ga yuborildi\n");
+        if (!prefs.smsLastError().isEmpty()) s.append("❗ SMS: ").append(prefs.smsLastError()).append(LF);
+        if (prefs.recTree() == null) s.append("Yozuvlar papkasi tanlanmagan — suhbat yozuvlari ERP'ga yuklanmaydi");
+        else {
+            s.append("✅ Yozuvlar papkasi: ").append(folderName(prefs.recTree())).append(" · yuklandi ").append(prefs.recUploaded()).append(" ta");
+            if (prefs.recLastAt() > 0) s.append(" · oxirgi ").append(fmt(prefs.recLastAt()));
+            if (!prefs.recLastError().isEmpty()) s.append(LF).append("❗ Yozuv: ").append(prefs.recLastError());
+        }
+        status.setText(s.toString().trim());
+    }
+
+    private boolean hasCallLog() {
+        return checkSelfPermission(Manifest.permission.READ_CALL_LOG) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    private void askPermissions() {
+        List<String> need = new ArrayList<>();
+        need.add(Manifest.permission.READ_CALL_LOG);
+        need.add(Manifest.permission.READ_PHONE_STATE);
+        need.add(Manifest.permission.SEND_SMS);
+        need.add(Manifest.permission.READ_SMS);
+        need.add(Manifest.permission.RECEIVE_SMS);
+        if (Build.VERSION.SDK_INT >= 33) need.add(Manifest.permission.POST_NOTIFICATIONS);
+        requestPermissions(need.toArray(new String[0]), 1);
+    }
+
+    @Override
+    public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults) {
+        refresh();
+        if (prefs.paired() && hasCallLog()) {
+            CallService.start(this);
+            CallSync.request(this);
+        }
+        if (prefs.paired() && SmsSender.allowed(this)) SmsSender.request(this);
+        if (prefs.paired() && SmsInbox.allowed(this)) SmsInbox.request(this);
+    }
+
+    private static String folderName(Uri tree) {
+        String id = DocumentsContract.getTreeDocumentId(tree);
+        int i = id.indexOf(':');
+        return i >= 0 && i < id.length() - 1 ? id.substring(i + 1) : id;
+    }
+
+    private void pickRecordingsFolder() {
+        if (!prefs.paired()) {
+            toast("Avval ERP'ga ulang");
+            return;
+        }
+        Intent i = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
+        i.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION | Intent.FLAG_GRANT_PREFIX_URI_PERMISSION);
+        try {
+            startActivityForResult(i, 2);
+        } catch (ActivityNotFoundException e) {
+            toast("Telefonda papka tanlash oynasi topilmadi");
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != 2 || resultCode != RESULT_OK || data == null || data.getData() == null) return;
+        Uri tree = data.getData();
+        try {
+            getContentResolver().takePersistableUriPermission(tree, Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        } catch (SecurityException e) {
+            toast("Bu papkaga ruxsat olib bo'lmadi — boshqa papka tanlang");
+            return;
+        }
+        prefs.recSetTree(tree);
+        toast("Papka tanlandi. Bundan keyingi yozuvlar yuklanadi");
+        CallService.start(this);
+        refresh();
+    }
+
+    private void uploadRecordingsNow() {
+        if (prefs.recTree() == null) {
+            toast("Avval yozuvlar papkasini tanlang");
+            return;
+        }
+        BG.execute(() -> {
+            int n = Recordings.run(this);
+            ui.post(() -> {
+                toast(n < 0 ? "Yuklanmadi: " + prefs.recLastError() : "Yuklandi: " + n + " ta yozuv");
+                refresh();
+            });
+        });
+    }
+
+    private void batteryExemption() {
+        try {
+            startActivity(new Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, Uri.parse("package:" + getPackageName())));
+        } catch (ActivityNotFoundException e) {
+            openAppSettings();
+        }
+    }
+
+    private void miuiAutostart() {
+        try {
+            Intent i = new Intent();
+            i.setComponent(new ComponentName("com.miui.securitycenter", "com.miui.permcenter.autostart.AutoStartManagementActivity"));
+            startActivity(i);
+        } catch (ActivityNotFoundException | SecurityException e) {
+            openAppSettings();
+        }
+    }
+
+    private void openAppSettings() {
+        startActivity(new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.parse("package:" + getPackageName())));
+    }
+
+    private void pair() {
+        String srv = server.getText().toString().trim();
+        String c = code.getText().toString().trim();
+        if (c.isEmpty()) {
+            toast("Ulash kodini kiriting");
+            return;
+        }
+        if (!hasCallLog()) {
+            toast("Avval ruxsatlarni bering");
+            askPermissions();
+            return;
+        }
+        BG.execute(() -> {
+            try {
+                JSONObject body = new JSONObject().put("code", c).put("app_version", CallSync.version(this));
+                JSONObject res = Api.request(srv, "pair/", null, body);
+                String device = res.getJSONObject("device").optString("name") + " (" + res.getJSONObject("device").optString("branch") + ")";
+                prefs.savePairing(srv, res.getString("token"), device, startOfToday());
+                ui.post(() -> {
+                    code.setText("");
+                    toast("Ulandi! Bugungi qo'ng'iroqlar yuborilmoqda");
+                    SyncJob.schedule(this);
+                    CallService.start(this);
+                    refreshLater();
+                });
+            } catch (Exception e) {
+                ui.post(() -> toast("Ulanmadi: " + e.getMessage()));
+            }
+        });
+    }
+
+    private void syncNow() {
+        if (!prefs.paired()) {
+            toast("Avval ERP'ga ulang");
+            return;
+        }
+        BG.execute(() -> {
+            int n = CallSync.run(this);
+            ui.post(() -> {
+                toast(n < 0 ? "Yuborilmadi: " + prefs.lastError() : "Yuborildi: " + n + " ta yangi qo'ng'iroq");
+                refresh();
+            });
+        });
+    }
+
+    private void refreshLater() {
+        refresh();
+        ui.postDelayed(this::refresh, 4000);
+    }
+
+    private static long startOfToday() {
+        Calendar c = Calendar.getInstance();
+        c.set(Calendar.HOUR_OF_DAY, 0);
+        c.set(Calendar.MINUTE, 0);
+        c.set(Calendar.SECOND, 0);
+        c.set(Calendar.MILLISECOND, 0);
+        return c.getTimeInMillis();
+    }
+
+    private static String fmt(long ms) {
+        return new SimpleDateFormat("dd.MM.yyyy HH:mm", Locale.US).format(new Date(ms));
+    }
+
+    private void toast(String s) {
+        Toast.makeText(this, s, Toast.LENGTH_LONG).show();
+    }
+
+    private int dp(int v) {
+        return Math.round(v * getResources().getDisplayMetrics().density);
+    }
+
+    private TextView text(String s, int sp) {
+        TextView t = new TextView(this);
+        t.setText(s);
+        t.setTextSize(sp);
+        t.setPadding(0, dp(4), 0, dp(4));
+        return t;
+    }
+
+    private TextView header(String s) {
+        TextView t = text(s, 17);
+        t.setTypeface(Typeface.DEFAULT_BOLD);
+        t.setPadding(0, dp(18), 0, dp(4));
+        return t;
+    }
+
+    private TextView label(String s) {
+        TextView t = text(s, 13);
+        t.setPadding(0, dp(8), 0, 0);
+        return t;
+    }
+
+    private Button button(String s, View.OnClickListener l) {
+        Button b = new Button(this);
+        b.setText(s);
+        b.setAllCaps(false);
+        b.setOnClickListener(l);
+        return b;
+    }
+}
diff --git a/app/src/main/java/uz/codial/calls/Prefs.java b/app/src/main/java/uz/codial/calls/Prefs.java
new file mode 100644
index 0000000..e5b1072
--- /dev/null
+++ b/app/src/main/java/uz/codial/calls/Prefs.java
@@ -0,0 +1,206 @@
+package uz.codial.calls;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Sozlamalar: server manzili, qurilma tokeni va oxirgi yuborilgan qo'ng'iroq vaqti. */
+final class Prefs {
+    static final String DEFAULT_SERVER = "https://erp.codialinfo.uz";
+
+    private final SharedPreferences sp;
+
+    Prefs(Context ctx) {
+        sp = ctx.getApplicationContext().getSharedPreferences("codial_calls", Context.MODE_PRIVATE);
+    }
+
+    String server() { return sp.getString("server", DEFAULT_SERVER); }
+    String token() { return sp.getString("token", ""); }
+    String deviceName() { return sp.getString("device", ""); }
+    long lastDate() { return sp.getLong("last_date", 0); }
+    long lastId() { return sp.getLong("last_id", 0); }
+    long lastSyncAt() { return sp.getLong("last_sync_at", 0); }
+    String lastError() { return sp.getString("last_error", ""); }
+    int sentTotal() { return sp.getInt("sent_total", 0); }
+    boolean paired() { return !token().isEmpty(); }
+
+    void savePairing(String server, String token, String device, long fromDate) {
+        sp.edit().putString("server", server).putString("token", token).putString("device", device)
+                .putLong("last_date", fromDate).putLong("last_id", 0).putLong("sms_in_last_id", 0).putLong("sms_in_from", fromDate)
+                .putString("last_error", "").putInt("sent_total", 0).apply();
+    }
+
+    void unpair(String why) {
+        sp.edit().putString("token", "").putString("last_error", why).apply();
+    }
+
+    void synced(long lastDate, long lastId, int accepted) {
+        sp.edit().putLong("last_date", Math.max(lastDate, lastDate())).putLong("last_id", Math.max(lastId, lastId()))
+                .putLong("last_sync_at", System.currentTimeMillis())
+                .putString("last_error", "").putInt("sent_total", sentTotal() + accepted).apply();
+    }
+
+    void error(String why) {
+        sp.edit().putString("last_error", why).apply();
+    }
+
+    long callsFullAt() { return sp.getLong("calls_full_at", 0); }
+
+    void callsFullScanned(long at) {
+        sp.edit().putLong("calls_full_at", at).apply();
+    }
+
+    // ---------- Kelgan SMS (1.2) ----------
+    long smsInLastId() { return sp.getLong("sms_in_last_id", 0); }
+    long smsInFullAt() { return sp.getLong("sms_in_full_at", 0); }
+    int smsInTotal() { return sp.getInt("sms_in_total", 0); }
+
+    /** Birinchi o'qish qaysi vaqtdan: ulanish kunining boshi (1.2 ga yangilanganda — yangilangan kun boshi). */
+    long smsInFrom() {
+        long v = sp.getLong("sms_in_from", 0);
+        if (v == 0) {
+            java.util.Calendar c = java.util.Calendar.getInstance();
+            c.set(java.util.Calendar.HOUR_OF_DAY, 0);
+            c.set(java.util.Calendar.MINUTE, 0);
+            c.set(java.util.Calendar.SECOND, 0);
+            c.set(java.util.Calendar.MILLISECOND, 0);
+            v = c.getTimeInMillis();
+            sp.edit().putLong("sms_in_from", v).apply();
+        }
+        return v;
+    }
+
+    void smsInSynced(long lastId, boolean fullDone) {
+        SharedPreferences.Editor e = sp.edit().putLong("sms_in_last_id", Math.max(lastId, smsInLastId()));
+        if (fullDone) e.putLong("sms_in_full_at", System.currentTimeMillis());
+        e.apply();
+    }
+
+    void smsInAccepted(int n) {
+        if (n > 0) sp.edit().putInt("sms_in_total", smsInTotal() + n).apply();
+    }
+
+    // ---------- SMS (2026-10-22) ----------
+    private static final Object LOCK = new Object();
+
+    int smsSentTotal() { return sp.getInt("sms_sent", 0); }
+    long smsLastAt() { return sp.getLong("sms_last_at", 0); }
+    String smsLastError() { return sp.getString("sms_error", ""); }
+
+    void smsQueued(int n) {
+        sp.edit().putLong("sms_last_at", System.currentTimeMillis()).apply();
+    }
+
+    void smsSent() {
+        synchronized (LOCK) {
+            sp.edit().putInt("sms_sent", smsSentTotal() + 1).putString("sms_error", "").putLong("sms_last_at", System.currentTimeMillis()).commit();
+        }
+    }
+
+    int smsDeliveredTotal() { return sp.getInt("sms_delivered", 0); }
+
+    void smsDelivered() {
+        synchronized (LOCK) {
+            sp.edit().putInt("sms_delivered", smsDeliveredTotal() + 1).commit();
+        }
+    }
+
+    /** «Ruxsat berilmagan» va tarmoq xatolari vaqtinchalik — holat tuzalgach ekrandan o'chadi (yuborish xatolari qoladi). */
+    void smsClearTransientError() {
+        String e = smsLastError();
+        if (e.startsWith("SMS yuborishga ruxsat") || e.startsWith("Internet")) smsError("");
+    }
+
+    void smsError(String why) {
+        sp.edit().putString("sms_error", why == null ? "" : why).apply();
+    }
+
+    /** Serverga hali yetkazilmagan yuborish natijalari (internet bo'lmagan payt). */
+    JSONArray pendingReports() {
+        synchronized (LOCK) {
+            try {
+                return new JSONArray(sp.getString("sms_reports", "[]"));
+            } catch (JSONException e) {
+                return new JSONArray();
+            }
+        }
+    }
+
+    void addPendingReport(JSONObject r) {
+        synchronized (LOCK) {
+            JSONArray a = pendingReports();
+            a.put(r);
+            sp.edit().putString("sms_reports", a.toString()).commit();
+        }
+    }
+
+    /** Yuborilgan birinchi `n` tasini o'chiradi (bu orada qo'shilganlari qoladi). */
+    void clearPendingReports(int n) {
+        synchronized (LOCK) {
+            JSONArray a = pendingReports();
+            JSONArray rest = new JSONArray();
+            for (int i = n; i < a.length(); i++) rest.put(a.opt(i));
+            sp.edit().putString("sms_reports", rest.toString()).commit();
+        }
+    }
+
+    // ---------- Suhbat yozuvlari (1.4) ----------
+    private static final int REC_DONE_MAX = 1500;
+
+    /** Yozuvchi ilova fayl saqlaydigan papka (Android «Papka tanlash» natijasi) yoki null. */
+    android.net.Uri recTree() {
+        String s = sp.getString("rec_tree", "");
+        return s.isEmpty() ? null : android.net.Uri.parse(s);
+    }
+
+    /** Papka tanlangan paytdan keyingi yozuvlargina yuklanadi (eski fayllar ERP'ga to'kilmasin). */
+    long recSince() { return sp.getLong("rec_since", 0); }
+    int recUploaded() { return sp.getInt("rec_uploaded", 0); }
+    long recLastAt() { return sp.getLong("rec_last_at", 0); }
+    String recLastError() { return sp.getString("rec_error", ""); }
+
+    void recSetTree(android.net.Uri tree) {
+        sp.edit().putString("rec_tree", tree == null ? "" : tree.toString()).putLong("rec_since", System.currentTimeMillis())
+                .putString("rec_error", "").apply();
+    }
+
+    void recError(String why) {
+        sp.edit().putString("rec_error", why == null ? "" : why).apply();
+    }
+
+    boolean recIsDone(String sig) {
+        synchronized (LOCK) {
+            return sp.getString("rec_done", "").contains(sig);
+        }
+    }
+
+    /** Yuklangan (ok) yoki tashlangan faylni eslab qoladi — qayta yuborilmaydi. */
+    void recDone(String sig, boolean uploaded) {
+        synchronized (LOCK) {
+            String[] all = sp.getString("rec_done", "").isEmpty() ? new String[0] : sp.getString("rec_done", "").split(",");
+            StringBuilder sb = new StringBuilder();
+            int from = Math.max(0, all.length - REC_DONE_MAX + 1);
+            for (int i = from; i < all.length; i++) sb.append(all[i]).append(',');
+            sb.append(sig);
+            SharedPreferences.Editor e = sp.edit().putString("rec_done", sb.toString());
+            if (uploaded) e.putInt("rec_uploaded", recUploaded() + 1).putLong("rec_last_at", System.currentTimeMillis());
+            e.apply();
+        }
+    }
+
+    /** Fayl birinchi marta qachon yuborilib, mos qo'ng'iroq topilmagani (kutish muddati hisobi uchun). */
+    long recFirstTry(String sig, long now) {
+        synchronized (LOCK) {
+            String key = "rec_try_" + sig;
+            long v = sp.getLong(key, 0);
+            if (v == 0) {
+                sp.edit().putLong(key, now).apply();
+                v = now;
+            }
+            return v;
+        }
+    }
+}
diff --git a/app/src/main/java/uz/codial/calls/Recordings.java b/app/src/main/java/uz/codial/calls/Recordings.java
new file mode 100644
index 0000000..5abf8f1
--- /dev/null
+++ b/app/src/main/java/uz/codial/calls/Recordings.java
@@ -0,0 +1,210 @@
+package uz.codial.calls;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.media.MediaMetadataRetriever;
+import android.net.Uri;
+import android.provider.DocumentsContract;
+
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Suhbat yozuvlari (1.4). Ilovaning o'zi suhbatni yozmaydi: telefondagi yozuvchi ilova (masalan ShizuCallRecorder)
+ * fayllarni tanlangan papkaga saqlaydi, bu yerda esa shu papka kuzatiladi va yangi fayllar ERP'ga yuklanadi.
+ * Mos qo'ng'iroqni server vaqt bo'yicha topadi (fayl o'zgargan vaqt + davomiylik). Qo'ng'iroq jurnaldan hali kelmagan bo'lsa,
+ * server «pending» deydi va fayl keyingi urinishda qayta yuboriladi (3 kungacha).
+ */
+final class Recordings {
+    private static final ExecutorService EXEC = Executors.newSingleThreadExecutor();
+    private static final long SETTLE_MS = 15_000L;          // fayl yopilishi uchun: oxirgi o'zgarishdan 15 soniya o'tgan bo'lsin
+    private static final long GIVE_UP_MS = 3 * 86_400_000L; // mos qo'ng'iroq 3 kunda topilmasa — tashlanadi
+    private static final int MAX_FILES = 3000;
+    private static final int MAX_DEPTH = 3;
+    private static final String[] EXT = {".m4a", ".aac", ".mp3", ".ogg", ".opus", ".oga", ".wav", ".amr", ".3gp", ".flac", ".mp4", ".webm"};
+
+    // Yozuvchi ilova fayl nomiga qo'ng'iroq raqamini yozadi: 20261118_115420.745+0500_out_+998901234567.ogg
+    // Vaqt zonasi (+0500) raqam emas: raqamni «_out_» / «_in_» dan keyingi qismdan olamiz, bo'lmasa — oxirgi 9–15 raqamli guruhdan
+    private static final Pattern NUMBER_AFTER_DIR = Pattern.compile("_(?:out|in|incoming|outgoing)_(\\+?\\d{7,15})", Pattern.CASE_INSENSITIVE);
+    private static final Pattern ANY_NUMBER = Pattern.compile("(\\+?\\d{9,15})");
+
+    private Recordings() {}
+
+    /** Fayl nomidagi telefon raqami yoki "" (yashirin raqam, nomda raqam yo'q). */
+    static String numberFromName(String name) {
+        Matcher m = NUMBER_AFTER_DIR.matcher(name);
+        if (m.find()) return m.group(1);
+        String last = "";
+        Matcher a = ANY_NUMBER.matcher(name.replaceFirst("^\\d{8}_\\d{6}(?:\\.\\d+)?[+-]\\d{4}", ""));
+        while (a.find()) last = a.group(1);
+        return last;
+    }
+
+    static boolean enabled(Context ctx) {
+        return new Prefs(ctx).paired() && new Prefs(ctx).recTree() != null;
+    }
+
+    static void request(Context ctx) {
+        Context app = ctx.getApplicationContext();
+        EXEC.execute(() -> run(app));
+    }
+
+    private static final class Item {
+        String docId, name;
+        long modified, size;
+        Uri uri;
+
+        String sig() {
+            try {
+                MessageDigest md = MessageDigest.getInstance("SHA-256");
+                byte[] d = md.digest((docId + "|" + size + "|" + modified).getBytes("UTF-8"));
+                StringBuilder sb = new StringBuilder();
+                for (int i = 0; i < 20; i++) sb.append(String.format(Locale.US, "%02x", d[i]));
+                return sb.toString();
+            } catch (Exception e) {
+                return docId + "|" + size + "|" + modified;
+            }
+        }
+    }
+
+    /** Sinxron (fon oqimida). Natija: yuklanganlar soni, xato bo'lsa -1. */
+    static synchronized int run(Context ctx) {
+        Prefs p = new Prefs(ctx);
+        Uri tree = p.recTree();
+        if (!p.paired() || tree == null) return 0;
+        // 2026-11-24: qo'ng'iroq davom etayotganda yozuv hali yozilmoqda — oraliq nusxalarni yuklamaymiz (ERP/guruhga qisqa nusxa ketmasin).
+        // Tugagach CallReceiver 30 s va 2 daqiqadan keyin qayta so'raydi.
+        try {
+            android.telephony.TelephonyManager tm = (android.telephony.TelephonyManager) ctx.getSystemService(Context.TELEPHONY_SERVICE);
+            if (tm != null && tm.getCallState() != android.telephony.TelephonyManager.CALL_STATE_IDLE) return 0;
+        } catch (SecurityException ignored) {
+            // ruxsat yo'q bo'lsa — avvalgidek ishlaydi
+        }
+        // avval qo'ng'iroqlar jurnali yuboriladi — server yozuvni shu yozuvlarga moslaydi
+        CallSync.run(ctx);
+        List<Item> found = new ArrayList<>();
+        try {
+            scan(ctx, tree, DocumentsContract.getTreeDocumentId(tree), 0, found);
+        } catch (SecurityException e) {
+            p.recError("Papkaga ruxsat yo'q — papkani qayta tanlang");
+            return -1;
+        } catch (RuntimeException e) {
+            p.recError("Papkani o'qib bo'lmadi: " + e.getMessage());
+            return -1;
+        }
+        long now = System.currentTimeMillis();
+        long since = p.recSince();
+        int sent = 0;
+        boolean failed = false;
+        for (Item it : found) {
+            if (it.modified < since || now - it.modified < SETTLE_MS) continue;
+            String sig = it.sig();
+            if (p.recIsDone(sig)) continue;
+            try {
+                String status = upload(ctx, p, it, sig);
+                if ("pending".equals(status)) {
+                    if (now - p.recFirstTry(sig, now) > GIVE_UP_MS) {
+                        p.recDone(sig, false);
+                        p.recError("Mos qo'ng'iroq topilmadi: " + it.name);
+                    }
+                    continue;
+                }
+                p.recDone(sig, true);
+                sent++;
+            } catch (Api.HttpError e) {
+                if (e.deviceRevoked()) {
+                    p.unpair("Ulanish bekor qilingan — ERP'dan yangi kod olib qayta ulang");
+                    return -1;
+                }
+                if (e.code == 400 || e.code == 413) {  // fayl yaroqsiz yoki juda katta — qayta urinish befoyda
+                    p.recDone(sig, false);
+                    p.recError(it.name + ": " + e.getMessage());
+                } else {
+                    p.recError("Server: " + e.getMessage());
+                    failed = true;
+                    break;
+                }
+            } catch (IOException e) {
+                p.recError("Internet yoki server bilan aloqa yo'q: " + e.getMessage());
+                failed = true;
+                break;
+            }
+        }
+        if (!failed && sent > 0) p.recError("");
+        return failed ? -1 : sent;
+    }
+
+    private static String upload(Context ctx, Prefs p, Item it, String sig) throws IOException {
+        long durMs = duration(ctx, it.uri);
+        JSONObject res;
+        try (InputStream in = ctx.getContentResolver().openInputStream(it.uri)) {
+            if (in == null) throw new IOException("Faylni ochib bo'lmadi");
+            res = Api.upload(p.server(), "recordings/", p.token(), in, it.name,
+                    new String[][]{{"ended_at", String.valueOf(it.modified)}, {"duration", String.valueOf(Math.round(durMs / 1000.0))}, {"sig", sig},
+                            {"number", numberFromName(it.name)}});
+        }
+        return res.optString("status");
+    }
+
+    private static long duration(Context ctx, Uri uri) {
+        MediaMetadataRetriever r = new MediaMetadataRetriever();
+        try {
+            r.setDataSource(ctx, uri);
+            String d = r.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION);
+            return d == null ? 0 : Long.parseLong(d);
+        } catch (RuntimeException e) {
+            return 0;
+        } finally {
+            try {
+                r.release();
+            } catch (IOException ignored) {
+                // yopishdagi xato yuklashga ta'sir qilmaydi
+            }
+        }
+    }
+
+    private static void scan(Context ctx, Uri tree, String parentDocId, int depth, List<Item> out) {
+        Uri children = DocumentsContract.buildChildDocumentsUriUsingTree(tree, parentDocId);
+        String[] cols = {DocumentsContract.Document.COLUMN_DOCUMENT_ID, DocumentsContract.Document.COLUMN_DISPLAY_NAME,
+                DocumentsContract.Document.COLUMN_MIME_TYPE, DocumentsContract.Document.COLUMN_LAST_MODIFIED, DocumentsContract.Document.COLUMN_SIZE};
+        List<String> dirs = new ArrayList<>();
+        try (Cursor c = ctx.getContentResolver().query(children, cols, null, null, null)) {
+            if (c == null) return;
+            while (c.moveToNext() && out.size() < MAX_FILES) {
+                String id = c.getString(0);
+                String name = c.getString(1) == null ? "" : c.getString(1);
+                String mime = c.getString(2) == null ? "" : c.getString(2);
+                if (DocumentsContract.Document.MIME_TYPE_DIR.equals(mime)) {
+                    if (depth < MAX_DEPTH) dirs.add(id);
+                    continue;
+                }
+                if (name.startsWith(".") || !isAudio(name, mime)) continue;
+                Item it = new Item();
+                it.docId = id;
+                it.name = name;
+                it.modified = c.getLong(3);
+                it.size = c.getLong(4);
+                it.uri = DocumentsContract.buildDocumentUriUsingTree(tree, id);
+                if (it.size > 0 && it.modified > 0) out.add(it);
+            }
+        }
+        for (String d : dirs) scan(ctx, tree, d, depth + 1, out);
+    }
+
+    private static boolean isAudio(String name, String mime) {
+        if (mime.startsWith("audio/")) return true;
+        String n = name.toLowerCase(Locale.US);
+        for (String e : EXT) if (n.endsWith(e)) return true;
+        return false;
+    }
+}
