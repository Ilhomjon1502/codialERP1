# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring. .env git'ga KIRMAYDI.
ENV_NAME=test                       # ichki nom (Docker loyihasi, /srv/codial-<nom>, zaxiralar). Haqiqiy tizim ham «test» nomida ishlaydi (2026-10-14 qarori)
WEB_PORT=8001                       # test: 8001, prod: 8002 (Nginx shu portga yo'naltiradi)

# Django
SECRET_KEY=                         # kamida 50 belgi: python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=erp.codialinfo.uz,test.77-42-9-23.sslip.io
CSRF_TRUSTED_ORIGINS=https://erp.codialinfo.uz,https://test.77-42-9-23.sslip.io
FRONTEND_URL=https://erp.codialinfo.uz # parol o'rnatish havolalari shu manzil bilan yuboriladi

# PostgreSQL (konteyner ichida)
POSTGRES_DB=codial
POSTGRES_USER=codial
POSTGRES_PASSWORD=                  # uzun tasodifiy parol

# Pochta (xodimlarga parol o'rnatish havolasi)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=                # Gmail bo'lsa: "App password"
DEFAULT_FROM_EMAIL="Codial ERP <noreply@codial.uz>"

# Telegram bot (M8) — serverda: bash deploy/set-telegram.sh
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ATTENDANCE_DELAY_MIN=30

# Mijozlar boti (o'quvchi va vasiylar) — serverda: bash deploy/set-clientbot.sh
CLIENT_BOT_TOKEN=
CLIENT_BOT_USERNAME=

# AI yordamchi (M9) — serverda: bash deploy/set-ai.sh
AI_PROVIDER=gemini                  # gemini | anthropic | openai
AI_API_KEY=
AI_MODEL=                           # bo'sh — provayder standarti
AI_DAILY_LIMIT=50

# Monitoring (M11): deploy/healthcheck.sh — Bosh menejerning Telegram chat raqami
ALERT_TELEGRAM_CHAT=

# Google Sheets hisobot (Foyda → «Hisobot olish») — deploy/set-google.sh to'ldiradi
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_SHEET_ID=
